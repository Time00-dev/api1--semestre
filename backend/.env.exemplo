# Copie este arquivo para backend/.env e preencha. O .env não vai para o GitHub.
DB_HOST=localhost
DB_PORT=3306
DB_NAME=negado_pelo_banco
DB_USER=
DB_PASSWORD=

# Senha que o Colab manda no cabeçalho X-Token-Carga para gravar pela rota POST /api/carga.
# Gere uma longa:  python -c "import secrets; print(secrets.token_urlsafe(32))"
# Em branco = a rota de carga fica desligada (o comando python backend/carga.py arquivo.json continua funcionando).
CARGA_TOKEN=
