# Copie este arquivo para backend/.env e preencha. O .env não vai para o GitHub.
DB_HOST=localhost
DB_PORT=3306
DB_NAME=negado_pelo_banco
DB_USER=
DB_PASSWORD=

# Senha que o Colab manda no cabeçalho X-Token-Carga para gravar pela rota POST /api/carga.
# Gere uma longa:  python -c "import secrets; print(secrets.token_urlsafe(32))"
# Em branco = a rota de carga fica desligada (o comando python backend/carga.py arquivo.json continua funcionando).
CARGA_TOKEN=

# IA opcional. Crie um token de acesso da equipe separado de CARGA_TOKEN.
OPENAI_API_KEY=
OPENAI_ANALYSIS_MODEL=gpt-5-mini
ANALYSIS_ACCESS_TOKEN=
ANALYSIS_DAILY_LIMIT=25
ANALYSIS_MONTHLY_LIMIT=150

# O Flask consulta o banco local por padrão. A prévia pode usar a API publicada.
ANALYSIS_DATA_URL=
# Origem do GitHub Pages, se frontend e API rodarem em domínios diferentes.
ANALYSIS_ALLOWED_ORIGIN=
